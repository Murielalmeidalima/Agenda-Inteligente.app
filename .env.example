# ─── CONFIGURAÇÕES DO SUPABASE (Obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-do-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-secreta-service-role-aqui

# ─── CAPTCHA - CLOUDFLARE TURNSTILE (Obrigatório se o CAPTCHA estiver ativo no Supabase)
# Criar em: dash.cloudflare.com → Turnstile → Add site (hostname do app)
# Configurar também no Supabase: Authentication → Attack Protection → CAPTCHA → Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=sua-site-key-turnstile-aqui

# ─── INTEGRADOR DE PAGAMENTOS - ASAAS (Opcional se bypass ativo)
# Sandbox: https://sandbox.asaas.com/api/v3 | Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=sua-chave-de-api-do-asaas-aqui

# ─── SERVIÇO DE DISPARO DE E-MAIL - RESEND (SMTP)
RESEND_API_KEY=re_sua-chave-api-do-resend-aqui
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASS=re_sua-chave-api-do-resend-aqui
EMAIL_FROM="Agenda Inteligente" <noreply@seudominio.com>

# ─── CONFIGURAÇÕES DO CRON JOB
CRON_SECRET=sua-chave-secreta-para-agendador-cron-aqui
